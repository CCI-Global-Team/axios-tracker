PORT=3100
API_BASE_URL="http://localhost:8000"

WEB_BASE_URL="http://localhost:3000"

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# If you prefer not to provide a Redis URL, you can set the REDIS_HOST and REDIS_PORT environment variables instead.
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL="redis://localhost:6379/"

# GitHub webhook -> Axios work item transitions (POST {LIVE_BASE_PATH}/github/webhook).
# Leave GITHUB_WEBHOOK_SECRET empty to keep the endpoint off (it answers 503).
GITHUB_WEBHOOK_SECRET=""
AXIOS_HOST="https://axios.joincci.org"
AXIOS_BOT_TOKEN=""
AXIOS_GITHUB_TOKEN=""
